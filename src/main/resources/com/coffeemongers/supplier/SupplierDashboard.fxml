<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="screenRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeemongers.controller.SupplierDashboardController" styleClass="main-layout,supplier-workspace">
 <left><fx:include fx:id="supplierSidebar" source="SupplierSidebar.fxml"/></left>
 <top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Supplier Workspace / Overview" styleClass="supplier-topbar-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="../view/RoleSwitcher.fxml"/></HBox></top>
 <center><ScrollPane fitToWidth="true" styleClass="content-scroll"><VBox spacing="20" styleClass="content">
  <HBox alignment="CENTER_LEFT" spacing="14"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="YOUR COFFEE SUPPLY" styleClass="supplier-eyebrow"/><Label fx:id="supplierHeading" text="Plan your next supply week" styleClass="page-title" wrapText="true"/><Label text="Your products, declared supply and incoming orders — in one place." styleClass="subtitle" wrapText="true"/></VBox><Button fx:id="refreshDashboardButton" text="Refresh" onAction="#refresh" styleClass="outline-button"/><Button fx:id="manageSupplyButton" text="＋ Declare Supply" onAction="#openWeeklySupply" styleClass="primary-button"/></HBox>
  <HBox spacing="14">
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active products" styleClass="stat-label"/><Label fx:id="productsCount" text="—" styleClass="stat-number"/><Label text="Products you offer" styleClass="small-text"/></VBox>
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Supply records" styleClass="stat-label"/><Label fx:id="supplyCount" text="—" styleClass="stat-number"/><Label text="Selected supply week" styleClass="small-text"/></VBox>
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Pending orders" styleClass="stat-label"/><Label fx:id="pendingOrdersCount" text="—" styleClass="stat-number"/><Label text="Awaiting Buyer receipt" styleClass="small-text"/></VBox>
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Completed orders" styleClass="stat-label"/><Label fx:id="completedOrdersCount" text="—" styleClass="stat-number"/><Label text="Receipt confirmed by Buyer" styleClass="small-text"/></VBox>
  </HBox>
  <Label text="01  Offer products     →     02  Declare weekly supply     →     03  Follow allocated orders" wrapText="true" styleClass="supplier-journey"/>
  <VBox spacing="12" styleClass="section-card"><HBox alignment="CENTER_LEFT" spacing="10"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Weekly Supply" styleClass="section-title"/><Label text="Declared, allocated and remaining quantities stay separate for each product." styleClass="small-text" wrapText="true"/></VBox><Label fx:id="weekLabel" styleClass="week-badge"/><DatePicker fx:id="dashboardWeekPicker" promptText="Choose supply week" prefWidth="160"/><Button fx:id="applyWeekButton" text="Apply" onAction="#refresh" styleClass="outline-button"/></HBox>
   <TableView fx:id="overviewSupplyTable" prefHeight="230" styleClass="data-table"><columns><TableColumn fx:id="productColumn" text="Product" prefWidth="230"/><TableColumn fx:id="declaredColumn" text="Declared" prefWidth="130"/><TableColumn fx:id="allocatedColumn" text="Allocated" prefWidth="130"/><TableColumn fx:id="remainingColumn" text="Remaining" prefWidth="130"/><TableColumn fx:id="priceColumn" text="Unit price" prefWidth="180"/></columns></TableView>
   <HBox alignment="CENTER_RIGHT" spacing="12"><Button fx:id="manageProductsButton" text="My Products" onAction="#openProducts" styleClass="outline-button"/><Button fx:id="viewSupplyButton" text="Manage weekly supply →" onAction="#openWeeklySupply" styleClass="outline-button"/></HBox>
  </VBox>
  <VBox spacing="12" styleClass="section-card"><HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Incoming Orders" styleClass="section-title"/><Label fx:id="ordersScopeLabel" styleClass="small-text"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="viewOrdersButton" text="View all orders →" onAction="#openOrders" styleClass="outline-button"/></HBox><TableView fx:id="recentOrdersTable" prefHeight="210" styleClass="data-table"><columns><TableColumn fx:id="orderColumn" text="Order" prefWidth="100"/><TableColumn fx:id="buyerColumn" text="Buyer" prefWidth="320"/><TableColumn fx:id="dateColumn" text="Created" prefWidth="150"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="160"/></columns></TableView></VBox>
  <Label fx:id="supplierStatusLabel" styleClass="status-message" wrapText="true"/>
 </VBox></ScrollPane></center>
</BorderPane>