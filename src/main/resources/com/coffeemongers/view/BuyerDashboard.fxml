<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="buyerRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeemongers.controller.BuyerDashboardController" styleClass="main-layout,buyer-workspace">
 <left><fx:include fx:id="buyerSidebar" source="BuyerSidebar.fxml"/></left>
 <top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Buyer Workspace / Overview" styleClass="buyer-topbar-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="RoleSwitcher.fxml"/></HBox></top>
 <center><ScrollPane fitToWidth="true" styleClass="content-scroll"><VBox spacing="20" styleClass="content">
  <HBox alignment="CENTER_LEFT" spacing="16"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="YOUR COFFEE SOURCING" styleClass="buyer-eyebrow"/><Label fx:id="shopHeading" text="Ready for your next coffee week?" styleClass="page-title"/><Label fx:id="dashboardSubtitle" text="Plan your needs. Track your allocation. Receive with confidence." styleClass="subtitle" wrapText="true"/></VBox><Button fx:id="refreshDemandsButton" text="Refresh" onAction="#refresh" styleClass="outline-button"/><Button fx:id="createDemandButton" text="＋ Create Demand" onAction="#createDemand" styleClass="primary-button"/></HBox>
  <HBox spacing="14">
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="All demands" styleClass="stat-label"/><Label fx:id="totalDemandsLabel" text="—" styleClass="stat-number"/><Label text="Your shop's requests" styleClass="small-text"/></VBox>
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Awaiting allocation" styleClass="stat-label"/><Label fx:id="pendingDemandsLabel" text="—" styleClass="stat-number"/><Label text="Open demands" styleClass="small-text"/></VBox>
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Awaiting receipt" styleClass="stat-label"/><Label fx:id="pendingOrdersLabel" text="—" styleClass="stat-number"/><Label text="Pending orders" styleClass="small-text"/></VBox>
   <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Reviews to write" styleClass="stat-label"/><Label fx:id="reviewsDueLabel" text="—" styleClass="stat-number"/><Label text="Completed, not reviewed" styleClass="small-text"/></VBox>
  </HBox>
  <HBox spacing="16" alignment="CENTER_LEFT" styleClass="buyer-journey"><Label text="01  Submit demand" styleClass="buyer-journey-step"/><Label text="→" styleClass="small-text"/><Label text="02  Admin allocates" styleClass="buyer-journey-step"/><Label text="→" styleClass="small-text"/><Label text="03  Receive &amp; review" styleClass="buyer-journey-step"/></HBox>
  <VBox styleClass="section-card" spacing="12"><HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Recent Demands" styleClass="section-title"/><Label text="Your requested products and delivery weeks" styleClass="small-text"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="viewDemandsButton" text="View all demands →" onAction="#myDemands" styleClass="outline-button"/></HBox>
   <TableView fx:id="recentDemandsTable" prefHeight="225" styleClass="data-table"><columns><TableColumn fx:id="demandIdColumn" text="Demand" prefWidth="95"/><TableColumn fx:id="productColumn" text="Products" prefWidth="245"/><TableColumn fx:id="quantityColumn" text="Requested" prefWidth="150"/><TableColumn fx:id="weekColumn" text="Delivery week" prefWidth="135"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="145"/></columns></TableView>
   <HBox alignment="CENTER_RIGHT"><Button fx:id="selectedDemandButton" text="View selected demand" onAction="#selectedDemand" styleClass="outline-button"/></HBox>
  </VBox>
  <VBox styleClass="section-card" spacing="12"><HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Recent Orders" styleClass="section-title"/><Label text="Orders created from confirmed allocations" styleClass="small-text"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="viewOrdersButton" text="View all orders →" onAction="#myOrders" styleClass="outline-button"/></HBox>
   <TableView fx:id="recentOrdersTable" prefHeight="210" styleClass="data-table"><columns><TableColumn fx:id="orderIdColumn" text="Order" prefWidth="100"/><TableColumn fx:id="orderDemandColumn" text="Demand" prefWidth="100"/><TableColumn fx:id="orderSupplierColumn" text="Supplier" prefWidth="330"/><TableColumn fx:id="orderStatusColumn" text="Status" prefWidth="170"/></columns></TableView>
  </VBox>
  <Label fx:id="workspaceStatus" styleClass="status-message" wrapText="true"/>
 </VBox></ScrollPane></center>
</BorderPane>
