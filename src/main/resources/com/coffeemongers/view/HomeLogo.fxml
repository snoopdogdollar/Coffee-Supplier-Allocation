<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeemongers.controller.HomeLogoController" spacing="10" alignment="CENTER_LEFT">
    <Button fx:id="homeButton" text="Coffee Mongers" styleClass="brand-home-button" onAction="#goHome">
        <graphic><ImageView fitWidth="28" fitHeight="30" preserveRatio="true"><image><Image url="@/images/logo.png"/></image><viewport><Rectangle2D minX="270" minY="35" width="195" height="195"/></viewport></ImageView></graphic>
    </Button>
    <fx:include source="EnvironmentStatus.fxml"/>
</HBox>
