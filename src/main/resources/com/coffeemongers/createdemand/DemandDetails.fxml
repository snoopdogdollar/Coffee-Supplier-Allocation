
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="detailsRoot" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeemongers.controller.DemandDetailsController"
            styleClass="main-layout,buyer-workspace">

<left><fx:include fx:id="buyerSidebar" source="../view/BuyerSidebar.fxml"/></left>
<top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Buyer Workspace / Demand Details" styleClass="buyer-topbar-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="../view/RoleSwitcher.fxml"/></HBox></top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="18" styleClass="content">
<HBox alignment="CENTER_LEFT" spacing="14"><Button text="← Back" onAction="#goBack" styleClass="back-button"/><VBox spacing="5"><Label text="Demand details" styleClass="page-title"/><Label text="Review your request and track the allocation confirmed by Admin." styleClass="subtitle" wrapText="true"/></VBox></HBox>

                <VBox styleClass="section-card" spacing="12">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label fx:id="demandIdLabel"
                                   text="#DM-004"
                                   styleClass="section-title"/>
                            <Label fx:id="demandTitleLabel"
                                   text="Requested products"
                                   styleClass="page-title"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="demandStatusLabel" text="DRAFT" styleClass="demand-status"/>
                    </HBox>
                </VBox>

                <VBox styleClass="section-card" spacing="12">
                    <Label text="Buyer Information" styleClass="section-title"/>
                    <GridPane hgap="30" vgap="12">
                        <Label text="Buyer Shop" GridPane.columnIndex="0"
                               GridPane.rowIndex="0" styleClass="small-text"/>
                        <Label text="Address" GridPane.columnIndex="1"
                               GridPane.rowIndex="0" styleClass="small-text"/>

                        <Label fx:id="shopNameLabel" text="Bếp Cà Phê" GridPane.columnIndex="0"
                               GridPane.rowIndex="1" styleClass="supplier-name"/>
                        <Label fx:id="shopCityLabel" text="Ho Chi Minh City" GridPane.columnIndex="1"
                               GridPane.rowIndex="1" styleClass="supplier-name"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="section-card" spacing="12">
                    <Label text="Coffee Products" styleClass="section-title"/>
                    <HBox styleClass="form-column-header">
                        <Label text="Coffee Product" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="Requested" minWidth="115" prefWidth="115" alignment="CENTER_RIGHT"/>
                        <Label text="Allocated" minWidth="115" prefWidth="115" alignment="CENTER_RIGHT"/>
                        <Label fx:id="remainingTitle" text="Remaining" minWidth="115" prefWidth="115" alignment="CENTER_RIGHT"/>
                    </HBox>
                    <VBox fx:id="detailsProductContainer" spacing="10"/>
                    <Separator/>
                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Label text="Requested product lines"
                               styleClass="form-label"/>
                        <Label fx:id="totalQuantityLabel"
                               text="0 lines"
                               styleClass="score"/>
                    </HBox>
                </VBox>

                <VBox fx:id="allocationSection" styleClass="section-card" spacing="12" visible="false" managed="false"><Label text="Confirmed supplier allocation" styleClass="section-title"/><Label text="The allocation is confirmed by Admin. Orders show receipt and review actions." wrapText="true" styleClass="small-text"/><VBox fx:id="allocationRows" spacing="10"/></VBox>
                <VBox styleClass="section-card" spacing="12">
                    <Label text="Request Details" styleClass="section-title"/>

                    <Label text="Request Date"
                           styleClass="small-text"/>
                    <Label fx:id="deliveryDateLabel"
                           text="-"
                           styleClass="supplier-name"/>

                    <Label fx:id="requiredWeekLabel" text="Required Delivery Week" styleClass="small-text"
                           visible="false" managed="false"/>
                    <Label fx:id="requiredWeekValue" styleClass="supplier-name"
                           visible="false" managed="false"/>

                    <Label text="Additional Notes"
                           styleClass="small-text"/>
                    <Label fx:id="notesLabel"
                           text="No additional notes"
                           wrapText="true"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="demand-actions">
            <Label fx:id="submissionMessage" styleClass="error-text" wrapText="true"
                   minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#goBack" styleClass="outline-button"/>
            <Button fx:id="refreshDemandButton" text="Refresh" onAction="#refreshDemand" styleClass="outline-button" visible="false" managed="false"/>
            <Button fx:id="demandActionButton" text="Submit Demand"
                    onAction="#demandAction" styleClass="primary-button"/>
        </HBox>
    </bottom>
</BorderPane>
