
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeemongers.controller.CreateDemandController"
            styleClass="main-layout,buyer-workspace">

<left><fx:include fx:id="buyerSidebar" source="../view/BuyerSidebar.fxml"/></left>
<top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Buyer Workspace / Create Demand" styleClass="buyer-topbar-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="../view/RoleSwitcher.fxml"/></HBox></top>

    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scroll"
                    pannable="true">

            <VBox spacing="18" styleClass="content">
<HBox alignment="CENTER_LEFT" spacing="14"><Button text="← Back" onAction="#goBack" styleClass="back-button"/><VBox spacing="5"><Label text="Create a demand" styleClass="page-title"/><Label text="Choose your products, quantities and delivery week." styleClass="subtitle" wrapText="true"/></VBox></HBox>

                <Label fx:id="previewNotice" text="Admin preview · sign in as a Buyer to submit requests." styleClass="info-card" wrapText="true" visible="false" managed="false"/>
<VBox styleClass="section-card" spacing="14">
                    <Label text="Buyer Information"
                           styleClass="section-title"/>
                    <Label fx:id="shopLabel" text="Your coffee shop"
                           styleClass="supplier-name"/>
                    <Label text="Shop details come from the selected buyer account."
                           styleClass="small-text"/>
                    <Label fx:id="dateLabel" text="Required Delivery Date *"
                           styleClass="form-label"/>
                    <DatePicker fx:id="requestDatePicker"
                                promptText="Choose a date in the delivery week"
                                maxWidth="Infinity"/>
                    <Label fx:id="requiredWeekPreview" styleClass="buyer-delivery-note" wrapText="true"/>
                </VBox>

                <VBox styleClass="section-card" spacing="14">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Coffee Products"
                                   styleClass="section-title"/>

                            <Label text="Select each coffee product and enter the requested quantity."
                                   styleClass="small-text"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="addProductButton" text="+ Add Product"
                                onAction="#addProductRow"
                                styleClass="outline-button"/>
                    </HBox>

                    <GridPane hgap="10"
                              maxWidth="Infinity"
                              styleClass="form-column-header">

                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="0"/>
                            <ColumnConstraints minWidth="100" prefWidth="100" maxWidth="100"/>
                            <ColumnConstraints minWidth="55" prefWidth="55" maxWidth="55"/>
                            <ColumnConstraints minWidth="160" prefWidth="160" maxWidth="220"/>
                            <ColumnConstraints minWidth="78" prefWidth="78" maxWidth="78"/>
                        </columnConstraints>

                        <Label text="Coffee Product"
                               GridPane.columnIndex="0"/>

                        <Label text="Quantity"
                               GridPane.columnIndex="1"/>

                        <Label text="Unit"
                               GridPane.columnIndex="2"/>

                        <Label text="Product note"
                               GridPane.columnIndex="3"/>

                        <Label text="Action"
                               GridPane.columnIndex="4"/>

                    </GridPane>

                    <VBox fx:id="productRowsContainer"
                          spacing="10"/>

                    <Label fx:id="catalogStatusLabel" styleClass="info-card" wrapText="true"
                           visible="false" managed="false"/>
                </VBox>

                <VBox styleClass="section-card" spacing="12">
                    <Label text="Additional Notes"
                           styleClass="section-title"/>

                    <Label text="Provide any quality requirements or special instructions."
                           styleClass="small-text"/>

                    <TextArea fx:id="notesField"
                              promptText="e.g. Prefer consistent bean size, moisture level, and natural processing..."
                              prefRowCount="4"
                              wrapText="true"/>
                </VBox>

                <Label text="Product quantities use the unit defined in the coffee product catalog."
                       styleClass="small-text"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="demand-actions">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Step 1 of 2 · Review your demand before submitting." styleClass="subtitle" wrapText="true"/>
                <Label fx:id="productErrorLabel" styleClass="error-text" wrapText="true"/>
            </VBox>
            <Button text="Cancel" onAction="#goBack" styleClass="outline-button"/>
            <Button fx:id="reviewDemandButton" text="Review Demand →"
                    onAction="#submitDemand" styleClass="primary-button"/>
        </HBox>
    </bottom>
</BorderPane>
