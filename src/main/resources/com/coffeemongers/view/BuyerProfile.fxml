<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeemongers.controller.BuyerProfileController" fx:id="screenRoot" styleClass="main-layout">
 <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar"><Button text="← Back" onAction="#goBack" styleClass="back-button"/><Label text="Profile" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="HomeLogo.fxml"/></HBox></top>
 <center><VBox spacing="18" styleClass="content"><VBox spacing="4"><Label text="Buyer Profile" styleClass="page-title"/><Label text="Your Coffee Mongers demo account." styleClass="subtitle"/></VBox><VBox spacing="14" styleClass="section-card" maxWidth="760"><GridPane hgap="20" vgap="14"><Label text="Full name" GridPane.rowIndex="0" styleClass="small-text"/><Label fx:id="nameLabel" text="—" GridPane.columnIndex="1" styleClass="supplier-name"/><Label text="Email" GridPane.rowIndex="1" styleClass="small-text"/><Label fx:id="emailLabel" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="supplier-name"/><Label text="Account role" GridPane.rowIndex="2" styleClass="small-text"/><Label fx:id="roleLabel" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="supplier-name"/><Label text="Demo user ID" GridPane.rowIndex="3" styleClass="small-text"/><Label fx:id="userIdLabel" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="supplier-name" wrapText="true"/></GridPane><Label fx:id="profileMessage" text="" styleClass="info-card" wrapText="true"/></VBox></VBox></center>
</BorderPane>
