<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeemongers.controller.SupplierDashboardController" fx:id="screenRoot" styleClass="main-layout">
 <left><VBox prefWidth="190" styleClass="supplier-sidebar" spacing="15"><Label text="☕ Coffee Mongers" styleClass="brand"/><Separator/><Button fx:id="dashboardNav" text="Dashboard" styleClass="nav-active" maxWidth="Infinity" onAction="#openDashboard"/><Button fx:id="weeklySupplyNav" text="Weekly Supply" styleClass="nav-button" maxWidth="Infinity" onAction="#openWeeklySupply"/><Button fx:id="ordersNav" text="My Orders" styleClass="nav-button" maxWidth="Infinity" onAction="#openOrders"/><Button fx:id="productsNav" text="Products" styleClass="nav-button" maxWidth="Infinity" onAction="#openProducts"/><Region VBox.vgrow="ALWAYS"/><Label fx:id="supplierNameLabel" text="Supplier account" styleClass="profile-name"/><fx:include source="../view/EnvironmentStatus.fxml"/></VBox></left>
 <top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Dashboard" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="../view/RoleSwitcher.fxml"/></HBox></top>
 <center><VBox spacing="20" styleClass="content"><VBox spacing="4"><Label text="Supplier Overview" styleClass="page-title"/><Label text="Manage your coffee catalog, weekly availability and incoming orders." styleClass="subtitle"/></VBox><HBox spacing="16"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Products" styleClass="stat-label"/><Label fx:id="productsCount" text="0" styleClass="stat-number"/><Button text="Manage products" onAction="#openProducts" styleClass="outline-button"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Weekly supply records" styleClass="stat-label"/><Label fx:id="supplyCount" text="0" styleClass="stat-number"/><Button text="Manage weekly supply" onAction="#openWeeklySupply" styleClass="outline-button"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Incoming orders" styleClass="stat-label"/><Label fx:id="ordersCount" text="0" styleClass="stat-number"/><Button text="View orders" onAction="#openOrders" styleClass="outline-button"/></VBox></HBox><VBox styleClass="info-card" spacing="8"><Label text="Supply quantity rule" styleClass="section-title"/><Label text="Available quantity is the supplier's initial weekly quantity. Remaining quantity changes as buyer allocations consume stock, and is not manually editable." styleClass="small-text" wrapText="true"/></VBox></VBox></center>
</BorderPane>
