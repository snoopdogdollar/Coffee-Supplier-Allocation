<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="screenRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeemongers.controller.MyOrdersController" styleClass="main-layout,buyer-workspace">
 <left><fx:include fx:id="buyerSidebar" source="BuyerSidebar.fxml"/></left>
 <top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Buyer Workspace / My Orders" styleClass="buyer-topbar-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="RoleSwitcher.fxml"/></HBox></top>
 <center><VBox spacing="20" styleClass="content">
  <HBox alignment="CENTER_LEFT" spacing="14"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="RECEIVE &amp; REVIEW" styleClass="buyer-eyebrow"/><Label text="My Orders" styleClass="page-title"/><Label text="Track the suppliers allocated to your demands. Confirm receipt, then share your feedback." styleClass="subtitle" wrapText="true"/></VBox><Button fx:id="createDemandButton" text="＋ Create Demand" onAction="#goToCreateDemand" styleClass="primary-button"/></HBox>
  <Label text="1. Admin confirms allocation     →     2. Confirm received     →     3. Review supplier" wrapText="true" styleClass="buyer-journey"/>
  <ScrollPane fitToWidth="true" styleClass="content-scroll" pannable="true" VBox.vgrow="ALWAYS" minHeight="100"><VBox fx:id="orderCardsContainer" spacing="18" styleClass="order-list"/></ScrollPane>
  <Label fx:id="emptyLabel" text="No orders yet. Orders appear here after Admin confirms an allocation for your demands." styleClass="empty-state" wrapText="true"/>
 </VBox></center>
 <bottom><VBox fx:id="liveOrderControls" spacing="8" styleClass="demand-actions" visible="true" managed="true"><Label fx:id="ordersStatusLabel" styleClass="status-message" wrapText="true"/><HBox alignment="CENTER_RIGHT" spacing="12"><Button text="Overview" onAction="#goToDashboard" styleClass="outline-button"/><Button fx:id="refreshOrdersButton" text="Refresh Orders" onAction="#refreshOrders" styleClass="outline-button"/><Button fx:id="loadMoreOrdersButton" text="Load More" onAction="#loadMoreOrders" styleClass="primary-button" disable="true"/></HBox></VBox></bottom>
</BorderPane>