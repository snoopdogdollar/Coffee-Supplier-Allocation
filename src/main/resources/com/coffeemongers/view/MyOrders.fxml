
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeemongers.controller.MyOrdersController"
            fx:id="screenRoot"
            styleClass="main-layout">

    <center>
        <VBox spacing="20" styleClass="content">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Back" onAction="#goToDashboard" styleClass="back-button"/>
                <Label text="My Orders"
                       styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="createDemandButton" text="+ Create New Demand" onAction="#goToCreateDemand" styleClass="primary-button"/>
                <fx:include source="HomeLogo.fxml"/>
            </HBox>

            <HBox fx:id="adBanner" alignment="CENTER_LEFT" spacing="14" styleClass="ad-banner">
                <ImageView fx:id="adImage" fitWidth="92" fitHeight="64" preserveRatio="true"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="FEATURED SUPPLIER" styleClass="sidebar-heading"/>
                    <Label fx:id="adHeadlineLabel" text="Featured coffee supplier" styleClass="supplier-name"/>
                    <Label fx:id="adMessageLabel" text="Discover a sourcing partner." styleClass="small-text" wrapText="true"/>
                </VBox>
                <Button fx:id="adActionButton" text="Meet supplier" styleClass="outline-button"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="▣"
                       styleClass="page-title"/>
                <VBox spacing="4">
                    <Label text="My Orders"
                           styleClass="page-title"/>
                    <Label text="View and track the orders created from your demands."
                           styleClass="subtitle"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true"
                        styleClass="content-scroll"
                        pannable="true" VBox.vgrow="ALWAYS" minHeight="100">

                <VBox fx:id="orderCardsContainer"
                      spacing="18"
                      styleClass="order-list"/>

            </ScrollPane>

            <Label fx:id="emptyLabel" text="No confirmed orders yet. Confirm a supplier allocation from Matching Results to create an order." styleClass="empty-state" wrapText="true"/>

        </VBox>
    </center>

    <bottom>
        <VBox fx:id="liveOrderControls" spacing="8" styleClass="demand-actions"
              visible="false" managed="false">
            <Label fx:id="ordersStatusLabel" styleClass="subtitle" wrapText="true"/>
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="refreshOrdersButton" text="Refresh Orders"
                        onAction="#refreshOrders" styleClass="outline-button"/>
                <Button fx:id="loadMoreOrdersButton" text="Load More"
                        onAction="#loadMoreOrders" styleClass="primary-button" disable="true"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
