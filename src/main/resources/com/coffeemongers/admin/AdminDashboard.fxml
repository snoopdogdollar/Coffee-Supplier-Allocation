<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.coffeemongers.controller.AdminDashboardController" fx:id="screenRoot" styleClass="main-layout">
 <left><VBox prefWidth="250" styleClass="admin-sidebar" spacing="14">
  <HBox alignment="CENTER_LEFT" spacing="10"><Label text="◉" styleClass="brand-mark"/><VBox><Label text="Coffee Mongers" styleClass="brand"/><Label text="ADMIN CONSOLE" styleClass="brand-subtitle"/></VBox></HBox>
  <VBox spacing="6" styleClass="workspace-card"><Label text="Coffee Mongers" styleClass="profile-name"/><Label text="Platform workspace" styleClass="small-text"/></VBox>
  <Button fx:id="allocationPreviewNav" text="Allocation Preview" styleClass="nav-button"
          onAction="#openAllocationPreview" maxWidth="Infinity" visible="false" managed="false"/>
  <Label text="WORKSPACE" styleClass="sidebar-heading"/><Button fx:id="overviewNav" text="▦   Overview" styleClass="nav-active" maxWidth="Infinity" onAction="#openOverview"/><Button fx:id="activityNav" text="▤   Orders &amp; Activity" styleClass="nav-button" onAction="#openActivity" maxWidth="Infinity"/><Button fx:id="shopsNav" text="♙   Coffee Shops" styleClass="nav-button" onAction="#openShops" maxWidth="Infinity"/><Button fx:id="suppliersNav" text="♧   Suppliers" styleClass="nav-button" onAction="#openSuppliers" maxWidth="Infinity"/><Button fx:id="productsNav" text="☕   Coffee Products" styleClass="nav-button" onAction="#openProducts" maxWidth="Infinity"/><Button fx:id="supplierProductsNav" text="▦   Supplier Products" styleClass="nav-button" onAction="#openSupplierProducts" maxWidth="Infinity"/><Button fx:id="supplyNav" text="▧   Supply Monitoring" styleClass="nav-button" onAction="#openSupply" maxWidth="Infinity"/><Button fx:id="reviewsNav" text="☆   Supplier Reviews" styleClass="nav-button" onAction="#openReviews" maxWidth="Infinity"/><Region VBox.vgrow="ALWAYS"/>
 </VBox></left>
 <top><HBox alignment="CENTER_LEFT" styleClass="topbar"><Label text="Overview" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><fx:include source="../view/RoleSwitcher.fxml"/></HBox></top>
 <center><ScrollPane fitToWidth="true" styleClass="content-scroll"><VBox spacing="22" styleClass="content">
  <HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Platform Overview" styleClass="page-title"/><Label fx:id="overviewSubtitle" text="Monitor Coffee Mongers marketplace activity." styleClass="subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox spacing="8" alignment="CENTER_RIGHT"><Label fx:id="scopeBadge" text="Demo session" styleClass="week-badge"/><Button fx:id="refreshOverviewButton" text="Refresh" onAction="#refreshOverview" styleClass="outline-button"/></VBox></HBox>
  <HBox spacing="16"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Total Orders" styleClass="stat-label"/><Label fx:id="totalOrdersLabel" text="0" styleClass="stat-number"/><Label fx:id="totalOrdersHint" text="This demo session" styleClass="small-text"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Pending Orders" styleClass="stat-label"/><Label fx:id="pendingOrdersLabel" text="0" styleClass="stat-number"/><Label text="Current order status" styleClass="small-text"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="Active Suppliers" styleClass="stat-label"/><Label fx:id="activeSuppliersLabel" text="0" styleClass="stat-number"/><Label fx:id="activeSuppliersHint" text="Local demo catalog" styleClass="small-text"/></VBox></HBox>
  <fx:include fx:id="composition" source="SupplyComposition.fxml"/>
  <VBox styleClass="section-card" spacing="12">
   <Label text="Weekly Supply &amp; Demand" styleClass="section-title"/>
   <HBox spacing="12" alignment="BOTTOM_LEFT">
    <VBox spacing="4"><Label text="Product" styleClass="small-text"/><ComboBox fx:id="chartProduct" prefWidth="300"/></VBox>
    <VBox spacing="4"><Label text="Ending ISO year" styleClass="small-text"/><TextField fx:id="chartEndYear" promptText="Year" prefWidth="105" maxWidth="105"/></VBox>
    <VBox spacing="4"><Label text="Ending week" styleClass="small-text"/><TextField fx:id="chartEndWeek" promptText="Week" prefWidth="85" maxWidth="85"/></VBox>
    <Button fx:id="applyChartButton" text="Apply" onAction="#refreshOverview" styleClass="outline-button"/>
   </HBox>
   <Label fx:id="weeklyChartScope" styleClass="small-text" wrapText="true"/>
   <BarChart fx:id="weeklyMarketChart" animated="false" legendVisible="true" prefHeight="320" minHeight="280" barGap="5" categoryGap="18" styleClass="weekly-market-chart">
    <xAxis><CategoryAxis label="ISO delivery week" animated="false"/></xAxis>
    <yAxis><NumberAxis fx:id="weeklyQuantityAxis" label="Quantity" forceZeroInRange="true" animated="false"/></yAxis>
   </BarChart>
   <Label fx:id="weeklyChartStatus" styleClass="small-text" wrapText="true"/>
  </VBox>
  <VBox fx:id="supplierRankingPanel" visible="false" managed="false" styleClass="section-card" spacing="12">
   <Label text="Top Suppliers" styleClass="section-title"/>
   <Label fx:id="rankingPolicyLabel" wrapText="true" styleClass="small-text"/>
   <VBox fx:id="topSupplierRows" spacing="10"/>
   <Label text="Supplier Performance · all suppliers" styleClass="section-title"/>
   <TableView fx:id="supplierPerformanceTable" prefHeight="230" styleClass="data-table"/>
   <Label fx:id="rankingStatusLabel" wrapText="true" styleClass="small-text"/>
  </VBox>
   <VBox styleClass="section-card" spacing="12"><HBox><Label text="Recent Orders" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="recentOrdersHint" text="Orders confirmed in this demo session" styleClass="small-text"/></HBox><TableView fx:id="ordersTable" prefHeight="190" styleClass="data-table"><columns><TableColumn fx:id="orderColumn" text="Order" prefWidth="150"/><TableColumn fx:id="businessColumn" text="Business" prefWidth="230"/><TableColumn fx:id="supplierColumn" text="Supplier" prefWidth="240"/><TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="140"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="160"/></columns></TableView></VBox>
  <Label fx:id="overviewNote" text="Demo workspace · sign in as the configured test Admin for PostgreSQL data." styleClass="small-text" wrapText="true"/>
 </VBox></ScrollPane></center>
<bottom><VBox fx:id="overviewFooter" visible="false" managed="false" spacing="6" styleClass="content"><Label fx:id="overviewStatusLabel" wrapText="true" styleClass="status-message"/></VBox></bottom>
</BorderPane>
